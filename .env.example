DATABASE_URL="postgresql://botc:botc@localhost:5432/botc_host_toll?schema=public"
# Locally, DIRECT_URL is the same connection as DATABASE_URL - the pooled
# vs. direct distinction only matters on hosted Postgres providers (e.g.
# Neon), where they're genuinely different connection strings.
DIRECT_URL="postgresql://botc:botc@localhost:5432/botc_host_toll?schema=public"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
